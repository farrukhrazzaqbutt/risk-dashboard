# Test image: dev dependencies + pytest (not used for production runtime).
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

# Include .flake8 so flake8 uses max-line-length=100 (same as ruff) inside the image.
COPY pyproject.toml uv.lock .flake8 ./
RUN uv sync --frozen --extra dev

COPY app ./app
COPY tests ./tests

CMD ["uv", "run", "pytest", "tests/", "-v"]
